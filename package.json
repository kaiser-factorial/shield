{
  "name": "@local/shield",
  "version": "1.6.0",
  "description": "Prompt injection defense utilities — detect, wrap, harden, log",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "src",
    "bin",
    "README.md"
  ],
  "bin": {
    "shield": "./dist/bin/shield-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "browser": "./dist/src/index.browser.js",
      "import": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/index.browser.d.ts",
      "import": "./dist/src/index.browser.js"
    },
    "./react": {
      "types": "./dist/src/react.d.ts",
      "import": "./dist/src/react.js"
    },
    "./shield": {
      "types": "./dist/src/shield.d.ts",
      "import": "./dist/src/shield.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "tsc && node --test dist/test/*.test.js && npm run check:versions",
    "logs": "node dist/bin/shield-cli.js logs",
    "scan": "node dist/bin/shield-cli.js scan",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20",
    "openai": ">=4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "openai": "^6.45.0",
    "react": "^19.2.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}

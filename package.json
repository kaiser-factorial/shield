{
  "name": "prompt-shield",
  "version": "1.9.0",
  "description": "Prompt injection defense for LLM apps \u2014 detect, wrap, harden, and watch model output and tool calls",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "shield": "./dist/bin/shield-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "browser": "./dist/src/index.browser.js",
      "import": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/index.browser.d.ts",
      "import": "./dist/src/index.browser.js"
    },
    "./node": {
      "types": "./dist/src/node.d.ts",
      "import": "./dist/src/node.js"
    },
    "./react": {
      "types": "./dist/src/react.d.ts",
      "import": "./dist/src/react.js"
    },
    "./anthropic": {
      "types": "./dist/src/anthropic.d.ts",
      "import": "./dist/src/anthropic.js"
    },
    "./openai": {
      "types": "./dist/src/openai.d.ts",
      "import": "./dist/src/openai.js"
    },
    "./shield": {
      "types": "./dist/src/shield.d.ts",
      "import": "./dist/src/shield.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "tsc && node --test dist/test/*.test.js && npm run check:versions",
    "logs": "node dist/bin/shield-cli.js logs",
    "scan": "node dist/bin/shield-cli.js scan",
    "check:versions": "node scripts/check-versions.mjs",
    "bench": "tsc && node --test dist/test/benchmark.test.js",
    "bench:corpus": "node scripts/make-corpus.mjs",
    "lint": "eslint src test bin"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20",
    "openai": ">=4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "eslint": "^9.39.5",
    "openai": "^6.45.0",
    "react": "^19.2.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "keywords": [
    "prompt-injection",
    "llm-security",
    "ai-security",
    "anthropic",
    "openai",
    "guardrails",
    "jailbreak-detection",
    "exfiltration",
    "tool-policy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaiser-factorial/shield.git"
  },
  "bugs": {
    "url": "https://github.com/kaiser-factorial/shield/issues"
  },
  "homepage": "https://github.com/kaiser-factorial/shield#readme"
}
